# Copy to `.env` (git-ignored) and fill in. Never commit real values.
#
# Semgrep Cloud Platform token — enables Pro rules. `task semgrep` uses your
# `semgrep login` session; this variable powers `semgrep ci` parity locally and
# is stored as the `SEMGREP_APP_TOKEN` GitHub Actions secret for CI.
SEMGREP_APP_TOKEN=

# Live CVP lab credentials for acceptance tests (sourced from gopass; see AGENTS.md).
# CVP_ENDPOINT=cvp.example.com:443
# CVP_AUTH_METHOD=bearer
# CVP_TOKEN=
# TF_ACC=1
